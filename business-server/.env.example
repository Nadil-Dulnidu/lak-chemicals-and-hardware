# ==============================================================================
# LAK Chemicals and Hardware - Business Server Environment Template
# ==============================================================================

# Server
PORT=8000
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL / Google Cloud SQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lak_chemicals
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Clerk Authentication (JWKS & Issuer)
CLERK_JWKS_URL=https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-instance>.clerk.accounts.dev

# Inter-Service Authentication (Multi-Agent Server & Internal APIs)
API_KEY=your_inter_service_api_key
API_KEY_HEADER=x-api-key

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_FRONTEND_URL=http://localhost:3000

# Google Cloud Storage (Bucket & Public CDN URL)
GCS_BUCKET_NAME=lak-chemicals-products
GCS_PUBLIC_URL_PREFIX=https://storage.googleapis.com/lak-chemicals-products

# AI Service (Multi-Agent Server)
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=your_inter_service_api_key
